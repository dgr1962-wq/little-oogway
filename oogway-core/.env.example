# Local TokenSpace v2 development database only.
TOKENSPACE_HOST=127.0.0.1
TOKENSPACE_PORT=55432
TOKENSPACE_DATABASE=tokenspace_v2_dev
TOKENSPACE_USER=tokenspace_dev
TOKENSPACE_PASSWORD=replace-with-the-value-from-tokenspace/.env
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
