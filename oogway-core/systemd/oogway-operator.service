[Unit]
Description=Little Oogway private machine operator and approval console
After=network-online.target docker.service

[Service]
Type=simple
ExecStart=/home/darren/Documents/Little-Oogway/oogway-core/scripts/run-operator-api.sh
Restart=on-failure
RestartSec=3
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/darren /mnt/storage

[Install]
WantedBy=default.target
