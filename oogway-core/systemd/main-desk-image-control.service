[Unit]
Description=Authenticated Little Oogway media workspace controller
After=network-online.target

[Service]
Type=simple
ExecStart=/home/darren/stable-diffusion/stable-diffusion-webui/venv/bin/python /home/darren/Documents/Little-Oogway/oogway-core/src/oogway_core/image_workspace_control.py
WorkingDirectory=/home/darren/Documents/Little-Oogway/oogway-core
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
