{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anykeycafe.com/schemas/tokensense-proposed-memory-v1.json",
  "title": "Proposed memory integration contract",
  "description": "A proposal only. This schema has no authority to write TokenSpace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "content", "evidence", "confidence", "status"],
  "properties": {
    "proposal_id": {"type": "string"},
    "content": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["proposed", "approved", "rejected", "superseded"]},
    "operator_ruling": {"type": ["object", "null"]}
  }
}
